APP_NAME=TriageFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# Docker sets DB_DATABASE to a file in the persistent database_data volume.
# Native setup uses database/database.sqlite when DB_DATABASE is unset.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BCRYPT_ROUNDS=12
# Server only: enter your API key here, never in a VITE_* variable.
OPENAI_API_KEY=
# Verified public identifier: gpt-6-luna. Enter it explicitly when enabling the API.
OPENAI_MODEL=
